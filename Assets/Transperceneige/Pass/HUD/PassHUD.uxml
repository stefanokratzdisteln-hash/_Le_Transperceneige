<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="PassHUD.uss" />
    <ui:VisualElement name="passRoot" class="pass-hud" picking-mode="Ignore">
        <ui:VisualElement name="frost" class="frost" picking-mode="Ignore" />
        <ui:VisualElement name="waybill" class="waybill" picking-mode="Ignore">
            <ui:Label name="place" class="place" />
            <ui:Label name="task" class="task" />
            <ui:Label name="mileage" class="mileage" />
        </ui:VisualElement>
        <ui:VisualElement name="reticle" class="reticle" picking-mode="Ignore"/>
        <ui:VisualElement class="foot-hud" picking-mode="Ignore">
            <ui:Label name="message" class="action" />
            <ui:VisualElement name="vitals" class="vitals" picking-mode="Ignore">
                <ui:Label name="healthNumber" class="health-number" />
                <ui:VisualElement class="health-track"><ui:VisualElement name="healthFill" class="health-fill" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="kit" class="kit" picking-mode="Ignore">
                <ui:VisualElement class="bag-column" picking-mode="Ignore">
                    <ui:Button name="bagBadge" class="bag-badge">
                        <ui:VisualElement name="bagDrawing" class="bag-drawing" picking-mode="Ignore" />
                        <ui:VisualElement class="value-line" picking-mode="Ignore"><ui:VisualElement name="bagDrop" class="drop" picking-mode="Ignore" /><ui:Label name="bagValue" class="value-number" picking-mode="Ignore" /></ui:VisualElement>
                    </ui:Button>
                    <ui:Label text="Tab" class="bag-key" />
                </ui:VisualElement>
                <ui:VisualElement name="quickSlots" class="slot-row" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="shortcuts" class="shortcuts" />
        </ui:VisualElement>
        <ui:VisualElement name="roomActions" class="room-actions hidden" picking-mode="Ignore">
            <ui:Button name="roomLanguage" class="command compact" text="English / 中文" />
            <ui:Button name="endGame" class="command compact" />
        </ui:VisualElement>
        <ui:VisualElement name="inventory" class="shade hidden">
            <ui:VisualElement class="folio inventory-leaf">
                <ui:Label name="inventoryTitle" class="headline" />
                <ui:Label name="capacity" class="caption"/>
                <ui:VisualElement name="allSlots" class="all-slots" />
                <ui:Label name="slotHelp" class="hint" />
                <ui:VisualElement class="commands">
                    <ui:Button name="closeBag" class="command" />
                    <ui:Button name="bagLanguage" class="command language" text="English / 中文" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="runBoard" class="run-board" picking-mode="Ignore">
            <ui:VisualElement class="run-line"><ui:Label name="clockCaption" class="run-caption" /><ui:Label name="runClock" class="run-number" /></ui:VisualElement>
            <ui:VisualElement class="run-line"><ui:Label name="targetCaption" class="run-caption" /><ui:VisualElement name="targetDrop" class="drop" /><ui:Label name="runTarget" class="run-value" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ending" class="shade hidden">
            <ui:VisualElement class="folio end-card">
                <ui:Label name="result" class="headline" />
                <ui:Label name="reason" class="description" />
                <ui:Button name="retry" class="command" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="titleScreen" class="shade hidden">
            <ui:VisualElement class="folio field-cover">
                <ui:Label name="gameTitle" class="headline" />
                <ui:Label name="settlement" class="settlement" />
                <ui:Label name="settledValue" class="settlement-value" />
                <ui:Button name="newGame" class="command" />
                <ui:Button name="quitGame" class="command" />
                <ui:Button name="titleLanguage" class="command language" text="English / 中文" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
