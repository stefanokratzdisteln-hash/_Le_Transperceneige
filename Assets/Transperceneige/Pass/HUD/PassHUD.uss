.pass-hud {
    position: absolute; top: 0; bottom: 0; left: 0; right: 0;
    color: #f5ecd7;
    -unity-font-definition: url("WinterbourneSans.ttf");
    -unity-font: url("WinterbourneSans.ttf");
}
.waybill {
    position: absolute; left: 27px; top: 24px; min-width: 200px; max-width: 420px;
    padding: 11px 18px 12px 16px; background-color: rgba(18,34,34,.88);
    border-left-width: 3px; border-left-color: #b4975f;
}
.frost { position:absolute; left:0; right:0; top:0; bottom:0; }
.place { white-space:normal; font-size: 23px; color: #fff4d9; }
.mileage { font-size: 14px; color: #cbb58d; margin-top: 3px; }
.task { font-size: 16px; color: #f1dbb2; margin-top: 5px; white-space: normal; }
.urgent { border-left-color: #f19159; }
.reticle {
    position:absolute; top:50%; left:50%; width:4px; height:4px;
    background-color:rgba(255,245,213,.82); border-radius:2px;
}
.foot-hud { position:absolute; bottom:16px; left:0; right:0; align-items:center; }
.slot-row { flex-direction:row; justify-content:center; }
.slot {
    width:58px; height:49px; margin:0 3px; padding:2px 5px;
    background-color:rgba(16,29,31,.83); border-width:1px; border-color:rgba(203,178,125,.64);
    border-radius:3px; color:#c3b293;
}
.slot-number { position:absolute; top:1px; left:5px; font-size:11px; color:#d2c29e; }
.glyph { position:absolute; top:6px; bottom:3px; left:11px; right:7px; }
.filled { background-color:rgba(53,56,39,.96); border-color:#e1bc77; }
.shortcuts { font-size:13px; padding:2px 8px; margin-top:4px; color:#eee4d0; background-color:rgba(16,27,30,.7); }
.action { font-size:17px; padding:5px 13px; margin-bottom:8px; background-color:rgba(18,32,33,.92); }
.shade { position:absolute; top:0; bottom:0; left:0; right:0; background-color:rgba(7,15,18,.72); justify-content:center; align-items:center; }
.folio { width:392px; max-width:94%; padding:24px; background-color:#213536; border-width:1px; border-color:#ac956a; }
.headline { font-size:28px; color:#fff1d5; }
.caption { font-size:15px; color:#d9c7a6; margin-top:4px; margin-bottom:13px; }
.all-slots { flex-direction:row; flex-wrap:wrap; }
.bag-slot { width:75px; height:64px; margin:3px; }
.bag-slot:hover, .selected { border-color:#ffe1a7; background-color:#48534a; }
.hint, .description { margin-top:13px; font-size:16px; color:#e5d9c1; white-space:normal; }
.command { margin-top:19px; align-self:flex-start; padding:6px 12px; border-width:1px; border-color:#ad965f; background-color:#354948; color:#fff3d5; font-size:16px; }
.command:hover { background-color:#4d6058; }
.room-actions { position:absolute; right:24px; top:24px; flex-direction:row; }
.compact { margin-top:0; margin-left:8px; background-color:rgba(18,34,34,.91); }
.commands { flex-direction:row; flex-wrap:wrap; justify-content:space-between; }
.language { align-self:flex-end; }
.headline { white-space:normal; }

/* The route card, objective and kit follow the three sightlines of the field sketch. */
.waybill { min-width:152px; max-width:340px; border-left-width:2px; padding:9px 15px; }
.task { margin-top:4px; color:#efe0c1; }
.kit { flex-direction:row; align-items:center; justify-content:center; }
.bag-badge { width:60px; height:60px; margin-right:9px; padding:0; flex-direction:column; align-items:center;
    justify-content:center; border-width:1px; border-color:#c3ac7d; border-radius:30px;
    color:#ebdfbf; background-color:rgba(18,32,36,.89); }
.bag-drawing { width:31px; height:31px; margin-top:2px; }
.bag-key { -unity-text-align:middle-center; font-size:12px; color:#e6d6ae; }
.inventory-leaf { background-image:url("Art/LedgerLeaf.png"); width:468px; padding:30px 34px; background-color:#e8dbc0; border-color:#b7975a; color:#30291f; }
.inventory-leaf .headline { color:#2b3535; }
.inventory-leaf .caption, .inventory-leaf .hint { color:#584e3c; }
.inventory-leaf .slot { width:81px; height:64px; margin:3px; border-radius:2px; background-color:#ddd0b5; border-color:#85795f; }
.inventory-leaf .slot-number { color:#524b3d; }
.inventory-leaf .filled, .inventory-leaf .selected { background-color:#b9ac8c; border-color:#534a33; }
.field-cover { background-image:url("Art/FieldBook.png"); width:402px; height:528px; max-height:90%; padding:31px 43px;
    justify-content:flex-end; background-color:#192e3a; border-color:#b79b67; }
.field-cover .headline { color:#f7dfaa; margin-bottom:10px; -unity-text-align:middle-center; }
.field-cover .command { align-self:stretch; margin-top:7px; background-color:rgba(19,35,41,.91); }
.field-cover .language { align-self:center; margin-top:12px; }

.run-board { position:absolute; top:22px; left:33%; right:33%; align-items:center; }
.run-line { min-height:25px; min-width:222px; flex-direction:row; justify-content:center; align-items:center;
    padding:1px 9px; background-color:rgba(17,31,37,.88); }
.run-caption { font-size:15px; color:#e8dabe; margin-right:8px; }
.run-number { font-size:21px; color:#fff2d1; -unity-font-style:bold; }
.run-value { font-size:15px; color:#f2dfab; }
.last-minute { color:#ffae83; }
.value-line { flex-direction:row; align-items:center; }
.drop { width:10px; height:14px; margin:0 4px 0 1px; }
.value-number { font-size:12px; color:#efdca7; }
.bag-column { align-items:center; margin-right:7px; }
.bag-badge { margin-right:0; }
.bag-key { background-color:rgba(17,31,37,.82); padding:0 4px; }
.vitals { width:234px; flex-direction:row; align-items:center; margin-left:63px; margin-bottom:2px; }
.health-number { min-width:30px; -unity-text-align:middle-center; padding:0 3px; font-size:14px; color:#f2e6d5; background-color:rgba(18,29,32,.90); }
.health-track { flex-grow:1; height:7px; margin-left:3px; background-color:#3b3232; border-width:1px; border-color:#ad977b; }
.health-fill { height:100%; background-color:#bf7057; }
.settlement { color:#f2d5a5; font-size:16px; white-space:normal; -unity-text-align:middle-center; }
.settlement-value { color:#d5c5a5; font-size:14px; -unity-text-align:middle-center; margin-bottom:8px; }
.hidden { display:none; }

.deploy-prompt { position:absolute; top:61%; left:15%; right:15%; flex-direction:row; align-items:center; justify-content:center; }
.deploy-key { font-size:22px; -unity-font-style:bold; color:#202b2e; padding:5px 13px; border-radius:3px; background-color:#f1d49a; }
.deploy-action { font-size:20px; color:#fff0cc; padding:6px 13px; background-color:rgba(25,31,34,.93); white-space:normal; }
.impact-loss { font-size:14px; -unity-font-style:bold; color:#ffb499; margin-left:4px; background-color:rgba(43,25,24,.90); }
.impact-result { font-size:16px; color:#edb190; margin-top:7px; white-space:normal; }
